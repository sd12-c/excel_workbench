/* ==========================================================================
   Excel 工作台 · 悬浮透镜同款视觉
   浅色柔光背景 + 半透明白玻璃卡片 + 靛蓝渐变主按钮 + 薄荷绿点缀
   ========================================================================== */

QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #26324a;
}

QMainWindow { background: #eaf1fb; }
QDialog { background: #edf3fd; }

#Root, #ContentArea, #ScrollBody, #SoftBackdrop,
QStackedWidget, QWidget#qt_scrollarea_viewport {
    background: transparent;
}

/* ============ 菜单 ============ */
QMenuBar {
    background: rgba(255, 255, 255, 110);
    border-bottom: 1px solid rgba(255, 255, 255, 150);
    padding: 2px 10px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 8px;
    color: #3f4b63;
}
QMenuBar::item:selected { background: rgba(255, 255, 255, 190); color: #2f5fe0; }

QMenu {
    background: #f8fbff;
    border: 1px solid rgba(255, 255, 255, 230);
    border-radius: 11px;
    padding: 5px;
}
QMenu::item { padding: 6px 26px 6px 12px; border-radius: 7px; color: #36425a; }
QMenu::item:selected { background: rgba(79, 124, 255, 28); color: #2f5fe0; }
QMenu::separator { height: 1px; background: rgba(120, 140, 175, 45); margin: 5px 8px; }

/* ============ 侧边栏 ============ */
#Sidebar {
    background: rgba(255, 255, 255, 132);
    border-right: 1px solid rgba(255, 255, 255, 175);
}
#BrandTitle { font-size: 15px; font-weight: 700; color: #172033; }
#BrandSub { font-size: 8px; color: #8d98ad; letter-spacing: 2px; }
#SidebarFooter { color: #9aa4b8; font-size: 9.5px; letter-spacing: 0.5px; }

/* ============ 页面标题 ============ */
#PageTitle { font-size: 22px; font-weight: 700; color: #172033; }
#PageSubtitle { font-size: 11.5px; color: #77839b; }
#ModeBadge {
    background: rgba(255, 255, 255, 150);
    border: 1px solid rgba(255, 255, 255, 220);
    border-radius: 11px;
    padding: 5px 11px;
    color: #4767e8;
    font-size: 9.5px;
    font-weight: 600;
}

/* ============ 卡片 ============ */
#Card {
    background: rgba(255, 255, 255, 145);
    border: 1px solid rgba(255, 255, 255, 205);
    border-radius: 18px;
}
#CardTitle { font-size: 13px; font-weight: 700; color: #24304a; }
#FieldLabel { color: #58657c; }
#HintLabel { color: #8a95a9; font-size: 11px; }

/* ============ 按钮 ============ */
QPushButton {
    background: rgba(255, 255, 255, 108);
    border: 1px solid rgba(255, 255, 255, 195);
    border-radius: 9px;
    padding: 7px 14px;
    color: #44506a;
}
QPushButton:hover {
    background: rgba(255, 255, 255, 186);
    border-color: rgba(79, 124, 255, 90);
    color: #2f5fe0;
}
QPushButton:pressed { background: rgba(232, 239, 255, 220); }
QPushButton:disabled {
    background: rgba(255, 255, 255, 55);
    border-color: rgba(255, 255, 255, 120);
    color: #aeb7c8;
}

QPushButton#PrimaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #5b86ff, stop:1 #3d6bf0);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 72);
    border-radius: 10px;
    padding: 9px 22px;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #6b95ff, stop:1 #4471f4);
}
QPushButton#PrimaryButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3357d6, stop:1 #2947b9);
}
QPushButton#PrimaryButton:disabled {
    background: rgba(188, 201, 227, 190);
    color: #f6f9ff;
    border-color: rgba(255, 255, 255, 80);
}

QPushButton#GhostButton {
    background: rgba(255, 255, 255, 105);
    border: 1px solid rgba(255, 255, 255, 195);
    border-radius: 9px;
    padding: 7px 14px;
    color: #44506a;
}
QPushButton#GhostButton:hover {
    background: rgba(255, 255, 255, 190);
    border-color: rgba(79, 124, 255, 100);
    color: #2f5fe0;
}
QPushButton#GhostButton:pressed { background: rgba(232, 239, 255, 220); }
QPushButton#GhostButton:disabled {
    background: rgba(255, 255, 255, 45);
    border-color: rgba(255, 255, 255, 100);
    color: #b0b9ca;
}

QPushButton#StopButton {
    background: rgba(255, 238, 238, 155);
    border: 1px solid rgba(226, 85, 99, 95);
    border-radius: 9px;
    padding: 7px 14px;
    color: #c93b4a;
}
QPushButton#StopButton:hover {
    background: rgba(255, 228, 228, 210);
    border-color: rgba(226, 85, 99, 150);
}
QPushButton#StopButton:pressed { background: rgba(255, 214, 214, 220); }
QPushButton#StopButton:disabled {
    background: rgba(255, 255, 255, 45);
    border-color: rgba(255, 255, 255, 100);
    color: #b6bfd0;
}

/* ============ 输入控件 ============ */
QLineEdit, QComboBox, QSpinBox, QDateEdit, QDoubleSpinBox {
    background: rgba(255, 255, 255, 150);
    border: 1px solid rgba(255, 255, 255, 210);
    border-radius: 9px;
    padding: 7px 10px;
    min-height: 18px;
    color: #2b3548;
    selection-background-color: #4f7cff;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { background: rgba(255, 255, 255, 185); }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus {
    border: 1px solid rgba(79, 124, 255, 170);
    background: rgba(255, 255, 255, 205);
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background: rgba(255, 255, 255, 62);
    color: #a7b0c1;
    border-color: rgba(255, 255, 255, 110);
}

QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow {
    image: url(@RES@/chevron.svg);
    width: 10px;
    height: 6px;
    margin-right: 9px;
}
QComboBox QAbstractItemView {
    border: 1px solid rgba(255, 255, 255, 220);
    border-radius: 10px;
    background: #f8fbff;
    selection-background-color: rgba(79, 124, 255, 30);
    selection-color: #2f5fe0;
    padding: 4px;
    outline: none;
}

QCheckBox { spacing: 8px; color: #3d4a62; }
QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid rgba(116, 136, 172, 150);
    border-radius: 5px;
    background: rgba(255, 255, 255, 170);
}
QCheckBox::indicator:hover { border-color: rgba(79, 124, 255, 180); }
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #5b86ff, stop:1 #3d6bf0);
    border-color: #4a75f2;
    image: url(@RES@/check.svg);
}
QCheckBox::indicator:disabled { background: rgba(255, 255, 255, 70); border-color: rgba(255, 255, 255, 120); }

QRadioButton { spacing: 8px; color: #3d4a62; }
QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid rgba(116, 136, 172, 150);
    border-radius: 9px;
    background: rgba(255, 255, 255, 170);
}
QRadioButton::indicator:hover { border-color: rgba(79, 124, 255, 180); }
QRadioButton::indicator:checked {
    border: 5px solid #4f7cff;
    background: #ffffff;
}

/* ============ 文件列表 ============ */
QListWidget#FileList {
    border: 1.5px dashed rgba(79, 124, 255, 100);
    border-radius: 14px;
    background: rgba(255, 255, 255, 90);
    padding: 8px;
    outline: none;
    color: #3d4a62;
}
QListWidget#FileList::item {
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 8px;
}
QListWidget#FileList::item:hover {
    background: rgba(255, 255, 255, 155);
    border-color: rgba(255, 255, 255, 200);
}
QListWidget#FileList::item:selected {
    background: rgba(79, 124, 255, 34);
    border-color: rgba(79, 124, 255, 60);
    color: #2f5fe0;
}

/* ============ 进度条 ============ */
QProgressBar {
    background: rgba(255, 255, 255, 105);
    border: 1px solid rgba(255, 255, 255, 160);
    border-radius: 5px;
    height: 8px;
    color: transparent;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5b86ff, stop:1 #46d3b0);
    border-radius: 4px;
}

/* ============ 运行日志 ============ */
#LogPanel { background: transparent; }
QTextEdit#LogView {
    background: rgba(255, 255, 255, 118);
    border: 1px solid rgba(255, 255, 255, 195);
    border-radius: 14px;
    color: #45516a;
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    font-size: 12px;
    padding: 12px;
    selection-background-color: rgba(79, 124, 255, 90);
    selection-color: #1e2a44;
}

/* ============ Tab ============ */
QTabWidget::pane { border: none; background: transparent; }
QTabBar::tab {
    background: rgba(255, 255, 255, 85);
    border: 1px solid rgba(255, 255, 255, 150);
    padding: 8px 18px;
    margin-right: 5px;
    border-radius: 9px;
    color: #5a6680;
}
QTabBar::tab:hover { background: rgba(255, 255, 255, 160); color: #2f5fe0; }
QTabBar::tab:selected {
    background: rgba(255, 255, 255, 190);
    border-color: rgba(79, 124, 255, 60);
    color: #2f5fe0;
    font-weight: 600;
}

/* ============ Splitter / 滚动条 ============ */
QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: rgba(79, 124, 255, 28); border-radius: 4px; }

QScrollArea, QScrollArea > QWidget#qt_scrollarea_viewport,
QScrollArea > QWidget > QWidget#ScrollBody {
    background: transparent;
    border: none;
}

QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar::handle:vertical {
    background: rgba(116, 136, 172, 105);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: rgba(79, 124, 255, 150); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 9px; margin: 2px; }
QScrollBar::handle:horizontal {
    background: rgba(116, 136, 172, 105);
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: rgba(79, 124, 255, 150); }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ============ 工具提示 / 消息框 ============ */
QToolTip {
    background: rgba(23, 32, 51, 245);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 8px;
    padding: 6px 10px;
}

QMessageBox { background: #f4f8ff; }
QMessageBox QLabel { color: #2b364c; }
QMessageBox QPushButton { min-width: 78px; }

/* ============ 预览对话框（与透镜同风格） ============ */
QDialog#PreviewDialog { background: #edf3fd; }
#PreviewTitle { font-size: 16px; font-weight: 700; color: #172033; }
#PreviewFilename { font-size: 10.5px; color: #78849b; }
#ReadonlyBadge {
    background: rgba(255, 255, 255, 145);
    border: 1px solid rgba(255, 255, 255, 215);
    border-radius: 8px;
    padding: 3px 8px;
    color: #64718a;
    font-size: 9px;
    font-weight: 600;
}
#PreviewInfo {
    background: rgba(255, 255, 255, 120);
    border: 1px solid rgba(255, 255, 255, 190);
    border-radius: 9px;
    padding: 6px 10px;
    color: #64718a;
    font-size: 10.5px;
}
QFrame#GlassPanel {
    background: rgba(255, 255, 255, 125);
    border: 1px solid rgba(255, 255, 255, 205);
    border-radius: 16px;
}
QTableWidget, QTableView {
    background: rgba(255, 255, 255, 88);
    border: 1px solid rgba(255, 255, 255, 175);
    border-radius: 10px;
    gridline-color: rgba(82, 104, 145, 24);
    alternate-background-color: rgba(255, 255, 255, 45);
    selection-background-color: rgba(79, 124, 255, 42);
    selection-color: #2f4fb8;
    outline: none;
    font-size: 12px;
}
QTableWidget::item, QTableView::item { padding: 4px 8px; }
QTableWidget#PreviewTable {
    background: transparent;
    border: none;
    font-size: 12px;
}
QTableWidget#PreviewTable::item { padding: 4px 8px; }
QHeaderView::section {
    background: rgba(255, 255, 255, 140);
    color: #4a5670;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 125);
    border-bottom: 1px solid rgba(255, 255, 255, 110);
    padding: 7px 8px;
    font-weight: 600;
    font-size: 11px;
}
QTableCornerButton::section {
    background: rgba(255, 255, 255, 120);
    border: none;
}

/* ============ 关于页 ============ */
#AboutTitle { font-size: 22px; font-weight: 700; color: #172033; }
#PrivacyBadge { font-size: 16px; font-weight: 700; color: #2f5fe0; }
#AboutText { color: #3d4a62; }
#AboutBullet { color: #545f73; }
