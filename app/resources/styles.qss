/* ============ 全局 ============ */
QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #2b3140;
}

#Root, #ContentArea { background: #f2f5fb; }

/* ============ 菜单 ============ */
QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #e6eaf3;
    padding: 2px 8px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected { background: #eef3ff; color: #2f5fe0; }
QMenu {
    background: #ffffff;
    border: 1px solid #e6eaf3;
    padding: 4px;
}
QMenu::item { padding: 6px 24px; border-radius: 6px; }
QMenu::item:selected { background: #eef3ff; color: #2f5fe0; }
QMenu::separator { height: 1px; background: #eef1f7; margin: 4px 8px; }

/* ============ 关于 ============ */
#AboutTitle { font-size: 22px; font-weight: 700; color: #1d2433; }
#PrivacyBadge { font-size: 16px; font-weight: 700; color: #2f5fe0; }
#AboutText { color: #3d4557; }
#AboutBullet { color: #545c70; }

/* ============ 侧边栏 ============ */
#Sidebar {
    background: #ffffff;
    border-right: 1px solid #e6eaf3;
}
#BrandIcon {
    background: #4f7cff;
    color: #ffffff;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 700;
}
#BrandTitle { font-size: 15px; font-weight: 700; color: #1d2433; }
#BrandSub { font-size: 10px; color: #9aa3b5; letter-spacing: 1px; }

QPushButton#NavButton {
    text-align: left;
    padding: 11px 14px;
    border: none;
    border-radius: 9px;
    background: transparent;
    color: #545c70;
}
QPushButton#NavButton:hover { background: #f0f4ff; color: #2f5fe0; }
QPushButton#NavButton:checked { background: #e8eeff; color: #2f5fe0; font-weight: 600; }

#SidebarFooter { color: #b6bece; font-size: 11px; }

/* ============ 页面标题 ============ */
#PageTitle { font-size: 20px; font-weight: 700; color: #1d2433; }
#PageSubtitle { font-size: 12px; color: #8b93a7; }

/* ============ 卡片 ============ */
#Card {
    background: #ffffff;
    border: 1px solid #e8ecf5;
    border-radius: 12px;
}
#CardTitle { font-size: 13px; font-weight: 600; color: #2b3140; }
#FieldLabel { color: #5a6273; }

/* ============ 按钮 ============ */
QPushButton#PrimaryButton {
    background: #4f7cff;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 9px 22px;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover { background: #3d6bf5; }
QPushButton#PrimaryButton:pressed { background: #2f5ce4; }
QPushButton#PrimaryButton:disabled { background: #b8c8f2; color: #f0f4ff; }

QPushButton#GhostButton {
    background: #ffffff;
    border: 1px solid #dbe1ee;
    border-radius: 8px;
    padding: 7px 14px;
    color: #4a5265;
}
QPushButton#GhostButton:hover { border-color: #4f7cff; color: #2f5fe0; background: #f7f9ff; }
QPushButton#GhostButton:pressed { background: #eef3ff; }
QPushButton#GhostButton:disabled { color: #b6bece; border-color: #eceff6; }

QPushButton#StopButton {
    background: #fff1f0;
    border: 1px solid #ffc9c4;
    border-radius: 8px;
    padding: 7px 14px;
    color: #d4380d;
}
QPushButton#StopButton:hover { background: #ffe7e5; border-color: #ff7875; }
QPushButton#StopButton:pressed { background: #ffd8d4; }
QPushButton#StopButton:disabled { background: #f7f9fc; border-color: #eceff6; color: #b6bece; }

/* ============ 输入控件 ============ */
QLineEdit, QComboBox, QSpinBox {
    background: #ffffff;
    border: 1px solid #dbe1ee;
    border-radius: 8px;
    padding: 7px 10px;
    min-height: 18px;
    selection-background-color: #4f7cff;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #4f7cff; }
QLineEdit:disabled, QComboBox:disabled { background: #f6f8fc; color: #a6aec0; }

QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow {
    image: url(@RES@/chevron.svg);
    width: 10px;
    height: 6px;
    margin-right: 9px;
}
QComboBox QAbstractItemView {
    border: 1px solid #dbe1ee;
    border-radius: 8px;
    background: #ffffff;
    selection-background-color: #e8eeff;
    selection-color: #2f5fe0;
    padding: 4px;
    outline: none;
}

QCheckBox { spacing: 8px; color: #3d4557; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #c7d0e2;
    border-radius: 4px;
    background: #ffffff;
}
QCheckBox::indicator:hover { border-color: #4f7cff; }
QCheckBox::indicator:checked {
    background: #4f7cff;
    border-color: #4f7cff;
    image: url(@RES@/check.svg);
}

QRadioButton { spacing: 8px; color: #3d4557; }
QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid #c7d0e2;
    border-radius: 8px;
    background: #ffffff;
}
QRadioButton::indicator:hover { border-color: #4f7cff; }
QRadioButton::indicator:checked {
    border: 5px solid #4f7cff;
    background: #ffffff;
}

/* ============ 文件列表 ============ */
QListWidget#FileList {
    border: 1.5px dashed #cdd6e8;
    border-radius: 10px;
    background: #fafbff;
    padding: 8px;
    outline: none;
}
QListWidget#FileList::item { padding: 7px 10px; border-radius: 6px; color: #3d4557; }
QListWidget#FileList::item:hover { background: #eef3ff; }
QListWidget#FileList::item:selected { background: #e0e9ff; color: #2f5fe0; }

#HintLabel { color: #9aa3b5; font-size: 12px; }

/* ============ 进度条 ============ */
QProgressBar {
    background: #eaeef7;
    border: none;
    border-radius: 4px;
    height: 8px;
    color: transparent;
}
QProgressBar::chunk { background: #4f7cff; border-radius: 4px; }

/* ============ 日志 ============ */
#LogPanel { background: transparent; }
QTextEdit#LogView {
    background: #141922;
    border: none;
    border-radius: 10px;
    color: #cbd3e3;
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    font-size: 12px;
    padding: 10px;
}

/* ============ Tab ============ */
QTabWidget::pane { border: none; }
QTabBar::tab {
    background: transparent;
    padding: 8px 18px;
    margin-right: 4px;
    border-radius: 8px;
    color: #6b7385;
}
QTabBar::tab:hover { background: #eef3ff; color: #2f5fe0; }
QTabBar::tab:selected { background: #e8eeff; color: #2f5fe0; font-weight: 600; }

/* ============ Splitter & ScrollBar ============ */
QSplitter::handle { background: transparent; }

QScrollArea, QScrollArea > QWidget#qt_scrollarea_viewport,
QScrollArea > QWidget > QWidget#ScrollBody {
    background: transparent;
    border: none;
}

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #d3dbeb; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #b9c5dd; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #d3dbeb; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

QToolTip {
    background: #1d2433;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
}

/* ============ 预览 ============ */
#PreviewDialog { background: #f2f5fb; }
QTableWidget#PreviewTable {
    background: #ffffff;
    border: 1px solid #e8ecf5;
    border-radius: 8px;
    gridline-color: #eef1f7;
    alternate-background-color: #f8faff;
    selection-background-color: #e0e9ff;
    selection-color: #2f5fe0;
    outline: none;
}
QTableWidget#PreviewTable::item { padding: 4px 8px; }
QHeaderView::section {
    background: #f4f7fd;
    color: #4a5265;
    border: none;
    border-right: 1px solid #e8ecf5;
    border-bottom: 1px solid #e8ecf5;
    padding: 6px 8px;
    font-weight: 600;
}